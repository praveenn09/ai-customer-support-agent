# Application Environment Variables (Copy to .env and fill with local values)
APP_NAME=SupportDesk
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security (Change JWT_SECRET_KEY in any real environment)
JWT_SECRET_KEY=change-this-to-a-long-random-local-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# PostgreSQL Database (host port 5433 avoids conflict with any local Postgres on 5432)
POSTGRES_USER=supportdesk
POSTGRES_PASSWORD=supportdesk_local_pass
POSTGRES_DB=supportdesk
DATABASE_URL=postgresql+psycopg2://supportdesk:supportdesk_local_pass@localhost:5433/supportdesk

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# AI Agent Configuration
# Options: "local" (deterministic offline agent) or "groq" / "openai_compatible"
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Business Rules
AUTO_REFUND_LIMIT_INR=5000

# Frontend API URL
VITE_API_URL=http://localhost:8000